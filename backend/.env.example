DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxx
DB_NAME=car_sales
FASTAPI_PORT=8001
# 管理端刷新密码。留空时 POST /api/v1/admin/data/refresh/stream 返回 503。
ADMIN_REFRESH_PASSWORD=
# 本地开发可留空（后端默认 CORS 为 *，且关闭 allow_credentials）。
# 跨域且需要携带 Cookie 时改成具体源，不要使用 *。
# CORS_ORIGINS=http://127.0.0.1:5999
# 日志：DEBUG / INFO / WARNING / ERROR（根 logger 控制台阈值；普通文件仍为 INFO+ 且不含 ERROR）
LOG_LEVEL=INFO
# 可选，默认 ./logs（相对于 python -m backend.main 的启动目录）
# LOG_DIR=/var/log/car-sales
